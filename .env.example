# Copy to .env and fill in. .env is git-ignored: never commit it.

# Home Assistant (Profile -> Security -> Long-lived access tokens)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=paste-your-long-lived-access-token-here

# Dashboard
PORT=3000
PI_HOSTNAME=raspberrypi.local

# Camera (Linux / Raspberry Pi: v4l2 device; the MJPEG stream from scripts/start-camera-stream.sh)
CAMERA_DEVICE=/dev/video0
CAMERA_STREAM_PORT=8081
